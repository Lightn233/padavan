+        key=trim(line);
+        if (!*key || *key=='#' || *key==';') continue;
+        value=strchr(key,'=');
+        if (!value) { bad=1; break; }
+        *value++='\0'; key=trim(key); value=trim(value);
+        if (!*key || !*value) { bad=1; break; }
+        if (*value=='\'' || *value=='"') {
+            char quote=*value++;
+            end=strchr(value,quote);
+            if (!end) { bad=1; break; }
+            *end++='\0'; end=trim(end);
+            if (*end && *end!='#' && *end!=';') { bad=1; break; }
+        } else {
+            end=strpbrk(value,"#;");
+            if (end) *end='\0';
+            value=trim(value);
+        }
+        if (field(&next,key,value)) { bad=1; break; }
     }
