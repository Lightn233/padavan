--- /dev/null
+++ b/recvchecked.h
@@ -0,0 +1,25 @@
+#ifndef DOGCOM_RECV_CHECKED_H
+#define DOGCOM_RECV_CHECKED_H
+#include <errno.h>
+
+/* 收包地址单独保存，不能让回复覆盖配置的认证服务器；长度先于字段读取。 */
+static int dogcom_recv(int fd, unsigned char *buf, size_t capacity,
+                      const struct sockaddr_in *expected, size_t minimum)
+{
+    struct sockaddr_in peer = {0};
+    socklen_t size = sizeof(peer);
+    int n = recvfrom(fd, buf, capacity, 0, (struct sockaddr *)&peer, &size);
+    if (n < 0) return n;
+    if (size < sizeof(peer) || peer.sin_family != expected->sin_family ||
+        peer.sin_port != expected->sin_port ||
+        peer.sin_addr.s_addr != expected->sin_addr.s_addr || (size_t)n < minimum) {
+#ifdef WIN32
+        WSASetLastError(WSAEMSGSIZE);
+#else
+        errno = EMSGSIZE;
+#endif
+        return -1;
+    }
+    return n;
+}
+#endif
