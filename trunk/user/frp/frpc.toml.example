# 示例地址不能用于真实连接；请填写自己的服务端地址及与服务端一致的令牌。
serverAddr = "192.0.2.1"
serverPort = 7000
auth.method = "token"
auth.token = "请填写独立的连接令牌"
log.to = "/tmp/frp/frpc.log"
log.level = "warn"
log.maxDays = 1

# 仅示例转发本机 HTTP，按实际用途调整，默认不会自动启用此示例文件。
[[proxies]]
name = "web"
type = "tcp"
localIP = "127.0.0.1"
localPort = 80
remotePort = 6000
