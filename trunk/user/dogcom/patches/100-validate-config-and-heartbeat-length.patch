+static int bool_value(int *dst, const char *s)
+{
+    if (!strcmp(s, "True") || !strcmp(s, "1")) *dst = 1;
+    else if (!strcmp(s, "False") || !strcmp(s, "0")) *dst = 0;
+    else return -1;
+    return 0;
+}
+
+static int ip_value(char *dst, size_t capacity, const char *s)
+{
+    struct in_addr parsed;
+    if (inet_pton(AF_INET, s, &parsed) != 1) return -1;
+    return copy_value(dst, capacity, s);
+}
+
+static int field(struct config *c, const char *key, const char *value)
+{
+#define TEXT(k) if (!strcmp(key, #k)) return copy_value(c->k, sizeof(c->k), value)
+#define IP(k) if (!strcmp(key, #k)) return ip_value(c->k, sizeof(c->k), value)
+#define BYTE(k) if (!strcmp(key, #k)) return hex_bytes(&c->k, 1, value, 0)
+#define BYTES(k) if (!strcmp(key, #k)) return hex_bytes(c->k, sizeof(c->k), value, 0)
+    IP(server);
+    if (!strcmp(mode,"pppoe")) {
+        BYTE(pppoe_flag); BYTE(keep_alive2_flag);
+        return 0;
     }
+    TEXT(username); TEXT(password); TEXT(host_name); TEXT(host_os);
+    IP(host_ip); IP(PRIMARY_DNS); IP(dhcp_server);
+    BYTE(CONTROLCHECKSTATUS); BYTE(ADAPTERNUM); BYTE(IPDOG);
+    BYTES(AUTH_VERSION); BYTES(KEEP_ALIVE_VERSION);
+    if (!strcmp(key, "mac")) return hex_bytes(c->mac, sizeof(c->mac), value, 1);
+    if (!strcmp(key, "ror_version")) return bool_value(&c->ror_version, value);
+    if (!strcmp(key, "keepalive1_mod")) return bool_value(&c->keepalive1_mod, value);
+    /* 保留通用配置里其他客户端专用字段的兼容性。 */
+    return 0;
+#undef TEXT
+#undef IP
+#undef BYTE
+#undef BYTES
+}
 
