# 开启/关闭插件示例（直接写 kernel/config 的行）
CONFIG_FIRMWARE_INCLUDE_SHADOWSOCKS=y
CONFIG_FIRMWARE_INCLUDE_XRAY=y
CONFIG_FIRMWARE_INCLUDE_V2RAY=n
CONFIG_FIRMWARE_INCLUDE_TROJAN=y
CONFIG_FIRMWARE_INCLUDE_SSOBFS=y

# 广告/DNS/内网穿透/其他
CONFIG_FIRMWARE_INCLUDE_ADBYBY=y
CONFIG_FIRMWARE_INCLUDE_SMARTDNS=n
CONFIG_FIRMWARE_INCLUDE_ZEROTIER=y

# SQM / WireGuard
CONFIG_FIRMWARE_INCLUDE_SQM=y
CONFIG_FIRMWARE_INCLUDE_WIREGUARD=y

# CPU 超频开关与频率（示例）Clock Rate: 1000Mhz=0x312 1100Mhz=0x362 1120Mhz=0x372 1200Mhz=0x3B2
CONFIG_FIRMWARE_INCLUDE_OC=y
CONFIG_FIRMWARE_MT7621_OC="0x372"
