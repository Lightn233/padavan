+    route_index=0
+    while [ "$route_index" -lt "$route_count" ]; do
+        enabled=$(nvram get "zero_enable_x$route_index")
+        destination=$(nvram get "zero_ip_x$route_index")
+        gateway=$(nvram get "zero_route_x$route_index")
+        route_index=$((route_index + 1))
+        [ "$enabled" = 1 ] || continue
