+static void pkt_data_log(char *header, uint8_t *pktdata, int len)
+{
+    char buffer[1024];
+    if (!header || !pktdata || len < 0) return;
+    int written = snprintf(buffer, sizeof(buffer), "%s len: %d", header, len);
+    if (written < 0) return;
+    size_t index = (size_t)written < sizeof(buffer) ? (size_t)written : sizeof(buffer)-1;
+    /* 大回复只截断调试输出，不改变协议处理内容。 */
+    for (int i=0; i<len && index + 7 < sizeof(buffer); i++) {
+        if (i % 16 == 0) { memcpy(buffer+index, "\n  ", 3); index += 3; }
+        written = snprintf(buffer+index, sizeof(buffer)-index, "%02x ", pktdata[i]);
+        if (written < 0) break;
+        index += written;
+    }
+    buffer[index] = 0;
+    log_info(logger, "%s", buffer);
+}
