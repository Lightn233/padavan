+    if (strcmp(operation,"success") && strcmp(operation,"failed") && strcmp(operation,"working")) strcpy(operation,"idle");
+    fprintf(stream,"{\"csrf\":\"%s\",\"state\":\"%s\",\"operation\":\"%s\"}",ddns_go_csrf,state,operation);
