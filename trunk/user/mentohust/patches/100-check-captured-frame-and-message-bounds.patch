+/* 限制账户输入并读完过长的一项，避免余下字符被误读为后面的选项。 */
+static int readAccount(char *out)
+{
+    size_t n = 0;
+    int ch, too_long = 0;
+    if (!out) return 0;
+    do { ch = getchar(); } while (ch != EOF && isspace((unsigned char)ch));
+    while (ch != EOF && !isspace((unsigned char)ch)) {
+        if (n < ACCOUNT_SIZE-1) out[n++] = ch;
+        else too_long = 1;
+        ch = getchar();
+    }
+    out[n] = 0;
+    if (too_long || n == 0) { out[0] = 0; return 0; }
+    return 1;
+}
+
+int getpasswd(char passwd[])
+{
+    struct termios original, hidden;
+    int ret;
+    if (tcgetattr(STDIN_FILENO, &original) != 0) return -1;
+    hidden = original;
+    hidden.c_lflag &= ~ECHOFLAGS;
+    if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &hidden) != 0) return -2;
+    ret = readAccount(passwd);
+    /* 恢复调用前的终端状态，不能强行开启原本关闭的回显。 */
+    if (tcsetattr(STDIN_FILENO, TCSAFLUSH, &original) != 0) return -2;
+    return ret ? 0 : 1;
 }
 
 
