modprobe xt_TPROXY
modprobe xt_set
TAG="_SS_SPEC_"   # comment tag
ipt_n="iptables -t nat"  # alias of iptables
ipt_m="iptables -t mangle"  # alias of iptables
FWI=/tmp/shadowsocks_iptables.save  # firewall include file
# 保留完整规则序号，避免第十条以后的序号被截断。
ADNU=$(iptables -t nat -L PREROUTING -n --line-number | awk '/ADBYBY/ && $1 ~ /^[0-9]+$/ {if ($1 > last) last=$1} END {print last+0}')
LAN_IF=${LAN_IF:-br0}
POLICY_STATE=/tmp/ss_spec.policy
# 只撤销本服务拥有的策略；旧版没有状态文件时用自己的 TPROXY 链识别。
owns_policy() {
    [ -f "$POLICY_STATE" ] || iptables-save -t mangle | grep -q '^:SS_SPEC_TPROXY '
}
SSNU=$(($ADNU+1))

usage() {
	cat <<-EOF
		Usage: ssr-rules [options]

		Valid options are:

		    -s <server_ip>          ip address of shadowsocksr remote server
		    -l <local_port>         port number of shadowsocksr local server
		    -S <server_ip>          ip address of shadowsocksr remote UDP server
		    -L <local_port>         port number of shadowsocksr local UDP server
		    -i <ip_list_file>       a file content is bypassed ip list
		    -a <lan_ips>            lan ip of access control, need a prefix to
		                            define access control mode
		    -b <wan_ips>            wan ip of will be bypassed
		    -w <wan_ips>            wan ip of will be forwarded
		    -p <fp_lan_ips>         lan ip of will be global proxy
		    -G <gm_lan_ips>         lan ip of will be game mode proxy
			-D <proxy_ports>        proxy ports
		    -e <extra_options>      extra options for iptables
		    -o                      apply the rules to the OUTPUT chain
		    -O                      apply the global rules to the OUTPUT chain
		    -u                      enable udprelay mode, TPROXY is required
		    -U                      enable udprelay mode, using different IP
		                            and ports for TCP and UDP
		    -f                      flush the rules
		    -g                      gfw list mode
		    -r                      return china mode
		    -k
		    -h                      show this help message and exit
EOF
	exit $1
}

loger() {
	# 1.alert 2.crit 3.err 4.warn 5.notice 6.info 7.debug
	logger -st ss-rules[$$] -p$1 $2
}

flush_r() {
	policy_owned=0;owns_policy && policy_owned=1
	flush_iptables() {
		ipt="iptables -t $1"
		DAT=$(iptables-save -t $1)
		CHAINS=$(echo "$DAT" | awk '/^:SS_SPEC/{print $1}' | sed -e 's/://g')
		eval $(echo "$DAT" | grep "$TAG" | sed -e 's/^-A/$ipt -D/' -e 's/$/;/')
		for chain in $CHAINS; do $ipt -F $chain 2>/dev/null; done
		for chain in $CHAINS; do $ipt -X $chain 2>/dev/null; done
	}
	sed -i '/dnsmasq.dom/d' /etc/storage/dnsmasq/dnsmasq.conf
	flush_iptables nat
	flush_iptables mangle
	if [ "$policy_owned" = 1 ]; then
		ip rule del fwmark 0x01/0x01 table 100 2>/dev/null
		ip route del local 0.0.0.0/0 dev lo table 100 2>/dev/null
		rm -f "$POLICY_STATE"
	fi
	ipset -X ss_spec_lan_ac 2>/dev/null
	ipset -X ss_spec_wan_ac 2>/dev/null
	ipset -X ssr_gen_router 2>/dev/null
	ipset -X china 2>/dev/null
	ipset -X fplan 2>/dev/null
	ipset -X gmlan 2>/dev/null
	ipset -X oversea 2>/dev/null
	ipset -X blacklist 2>/dev/null
	ipset -X whitelist 2>/dev/null
	[ -n "$FWI" ] && echo '#!/bin/sh' >$FWI
	return 0
}

ipset_r() {
    mkdir -p /tmp/dnsmasq.dom
	ipset -N china hash:net 2>/dev/null
	ipset -N gmlan hash:net 2>/dev/null
	for ip in $LAN_GM_IP; do ipset -! add gmlan $ip; done
	$ipt_n -N SS_SPEC_WAN_AC || return 1
	$ipt_n -I SS_SPEC_WAN_AC -p tcp ! --dport 53 -d $server -j RETURN || return 1
	if [ "$RUNMODE" = "router" ] ;then
	ipset -! -R <<-EOF || return 1
		create ss_spec_wan_ac hash:net
		$(gen_iplist | sed -e "s/^/add ss_spec_wan_ac /")
EOF
	ipset -N china hash:net 2>/dev/null
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set ss_spec_wan_ac dst -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set china dst -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set gmlan src -m set ! --match-set china dst -j SS_SPEC_WAN_FW || return 1
	$ipt_n -A SS_SPEC_WAN_AC -j SS_SPEC_WAN_FW || return 1
	if [ ! -f "/etc/storage/gfwlist/gfwlist_listnew.conf" ] ; then
	mkdir -p /etc/storage/gfwlist
	cp -rf /etc_ro/gfwlist_list.conf /etc/storage/gfwlist/gfwlist_listnew.conf
	fi
	if [ ! -f "/tmp/dnsmasq.dom/gfwlist_list.conf" ] ; then
	lua /etc_ro/ss/gfwcreate.lua
	fi
	elif [ "$RUNMODE" = "gfw" ] ;then
	ipset -N gfwlist hash:net 2>/dev/null
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set china dst -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set gfwlist dst -j SS_SPEC_WAN_FW || return 1
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set gmlan src -m set ! --match-set china dst -j SS_SPEC_WAN_FW || return 1
	if [ ! -f "/etc/storage/gfwlist/gfwlist_listnew.conf" ] ; then
	mkdir -p /etc/storage/gfwlist
	cp -rf /etc_ro/gfwlist_list.conf /etc/storage/gfwlist/gfwlist_listnew.conf
	fi
	if [ ! -f "/tmp/dnsmasq.dom/gfwlist_list.conf" ] ; then
	lua /etc_ro/ss/gfwcreate.lua
	fi
	elif [ "$RUNMODE" = "oversea" ] ;then
	ipset -N oversea hash:net 2>/dev/null
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set oversea dst -j SS_SPEC_WAN_FW || return 1
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set gmlan src -j SS_SPEC_WAN_FW || return 1
	$ipt_n -A SS_SPEC_WAN_AC -m set --match-set china dst -j SS_SPEC_WAN_FW || return 1
	elif [ "$RUNMODE" = "all" ] ;then
	$ipt_n -A SS_SPEC_WAN_AC -j SS_SPEC_WAN_FW || return 1
	fi
	# 仅接管 LAN 入站；DNS 留给现有 dnsmasq/AdGuardHome 规则。
	$ipt_n -I PREROUTING $SSNU -i "$LAN_IF" -p tcp ! --dport 53 -m comment --comment "$TAG" -j SS_SPEC_WAN_AC || return 1
	ipset -N whitelist hash:net 2>/dev/null
	ipset -N blacklist hash:net 2>/dev/null
	cat /etc/storage/ss_dom.sh | grep -v '^!' | grep -v "^$" > /tmp/ss_dom.txt
	awk '{printf("ipset=/%s/blacklist\n", $1, $1 )}' /tmp/ss_dom.txt > /tmp/dnsmasq.dom/ss_dom.conf
	cat /etc/storage/uss_dom.sh | grep -v '^!' | grep -v "^$" > /tmp/uss_dom.txt
	awk '{printf("ipset=/%s/whitelist\n", $1, $1 )}' /tmp/uss_dom.txt > /tmp/dnsmasq.dom/uss_dom.conf
    rm -f /tmp/ss_dom.txt
	rm -f /tmp/uss_dom.txt
	$ipt_n -I SS_SPEC_WAN_AC 2 -m set --match-set blacklist dst -j SS_SPEC_WAN_FW || return 1
	$ipt_n -I SS_SPEC_WAN_AC 2 -m set --match-set whitelist dst -j RETURN || return 1

	for ip in $WAN_BP_IP; do ipset -! add whitelist $ip; done
	for ip in $WAN_FW_IP; do ipset -! add blacklist $ip; done
	
	sed -i '/dnsmasq.dom/d' /etc/storage/dnsmasq/dnsmasq.conf
cat >> /etc/storage/dnsmasq/dnsmasq.conf << EOF
conf-dir=/tmp/dnsmasq.dom/
EOF

	return $?
}

fw_rule() {
	$ipt_n -N SS_SPEC_WAN_FW || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 0.0.0.0/8 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 10.0.0.0/8 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 127.0.0.0/8 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 169.254.0.0/16 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 172.16.0.0/12 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 192.168.0.0/16 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 224.0.0.0/4 -j RETURN || return 1
	$ipt_n -A SS_SPEC_WAN_FW -d 240.0.0.0/4 -j RETURN || return 1
	if [ "$LANCON" = "all" ];then
	ipset -N fplan hash:net 2>/dev/null
	for ip in $LAN_FP_IP; do ipset -! add fplan $ip ; done
	$ipt_n -I SS_SPEC_WAN_FW -m set --match-set fplan src -j RETURN || return 1
	elif [ "$LANCON" = "bip" ];then
	ipset -N fplan hash:net 2>/dev/null
	for ip in $LAN_FP_IP; do ipset -! add fplan $ip ; done
	lanbip="-m set --match-set fplan src"
	fi

	$ipt_n -A SS_SPEC_WAN_FW -p tcp $PROXY_PORTS $lanbip \
		-j REDIRECT --to-ports $local_port 2>/dev/null || {
		loger 3 "Can't redirect, please check the iptables."
		return 1
	}
	return $?
}

ac_rule() {
	if [ -n "$OUTPUT" ]; then
		$ipt_n -N SS_SPEC_WAN_DG || return 1
		$ipt_n -A SS_SPEC_WAN_DG -p tcp -j $OUTPUT || return 1
		$ipt_n -I OUTPUT 1 -p tcp ! --dport 53 -m comment --comment "$TAG" -j SS_SPEC_WAN_DG || return 1
		$ipt_n -I PREROUTING $(($SSNU+1)) -i "$LAN_IF" -p tcp ! --dport 53 -m comment --comment "$TAG" -j SS_SPEC_WAN_DG || return 1
	fi
	return $?
}

tp_rule() {
	[ -n "$TPROXY" ] || return 0
	# 以内核实际接受规则为准，兼容内建 TPROXY；失败必须返回错误。
	ip rule add fwmark 0x01/0x01 table 100 || return 1
	: > "$POLICY_STATE" || return 1
	ip route add local 0.0.0.0/0 dev lo table 100 || return 1

	$ipt_m -N SS_SPEC_TPROXY || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp --dport 80 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp --dport 443 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp --dport 53 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 0.0.0.0/8 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 10.0.0.0/8 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 127.0.0.0/8 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 169.254.0.0/16 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 172.16.0.0/12 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 192.168.0.0/16 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 224.0.0.0/4 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d 240.0.0.0/4 -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -d $SERVER -j RETURN || return 1
	if [ "$TPROXY" -ne 1 ]; then
	$ipt_n -I SS_SPEC_WAN_AC 1 -d $server -j RETURN || return 1
	fi

	#$ipt -A SS_SPEC_TPROXY -p udp $PROXY_PORTS $lanbip \
		#-j TPROXY --on-port "$LOCAL_PORT" --tproxy-mark 100

	if [ "$RUNMODE" = "router" ] ;then
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set --match-set ss_spec_wan_ac dst -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set --match-set china dst -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set --match-set gmlan src -m set ! --match-set china dst -j TPROXY \
	--on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp $PROXY_PORTS -m set ! --match-set ss_spec_wan_ac dst -j TPROXY \
	--on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -I SS_SPEC_TPROXY -p udp --dport 5353 -j RETURN || return 1

	elif [ "$RUNMODE" = "gfw" ] ;then
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set --match-set china dst -j RETURN || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set  $PROXY_PORTS --match-set gfwlist dst -j TPROXY \
	--on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set --match-set gmlan src -m set ! --match-set china dst -j TPROXY \
	--on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -I SS_SPEC_TPROXY -p udp --dport 5353 -j RETURN || return 1

	elif [ "$RUNMODE" = "oversea" ] ;then
	$ipt_m -A SS_SPEC_TPROXY -p udp $PROXY_PORTS -m set --match-set oversea dst \
	-j TPROXY --on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp -m set --match-set gmlan src \
	-j TPROXY --on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -A SS_SPEC_TPROXY -p udp $PROXY_PORTS -m set --match-set china dst \
	-j TPROXY --on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1

	elif [ "$RUNMODE" = "all" ] ;then
	$ipt_m -A SS_SPEC_TPROXY -p udp $PROXY_PORTS -j TPROXY --on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	fi
	# UDP 与 TCP 使用相同的终端选择，避免被排除的终端仍被 UDP 接管。
	lan_udp_filter=
	if [ "$LANCON" = "all" ]; then
		lan_udp_filter="-m set ! --match-set fplan src"
	elif [ "$LANCON" = "bip" ]; then
		lan_udp_filter="-m set --match-set fplan src"
	fi
	$ipt_m -A PREROUTING -i "$LAN_IF" -p udp ! --dport 53 $lan_udp_filter -m comment --comment "$TAG" -j SS_SPEC_TPROXY || return 1
    $ipt_m -I SS_SPEC_TPROXY -p udp $PROXY_PORTS -m set --match-set blacklist dst \
    -j TPROXY --on-port "$LOCAL_PORT" --tproxy-mark 0x01/0x01 || return 1
	$ipt_m -I SS_SPEC_TPROXY -p udp -m set --match-set whitelist dst -j RETURN || return 1

	return $?
}

get_wan_ip() {
	cat <<-EOF | grep -E "^([0-9]{1,3}\.){3}[0-9]{1,3}"
		$server
		$SERVER
		$WAN_BP_IP
EOF
}

gen_iplist() {
	cat <<-EOF
		0.0.0.0/8
		10.0.0.0/8
		100.64.0.0/10
		127.0.0.0/8
		169.254.0.0/16
		172.16.0.0/12
		192.0.0.0/24
		192.0.2.0/24
		192.88.99.0/24
		192.168.0.0/16
		198.18.0.0/15
		198.51.100.0/24
		203.0.113.0/24
		224.0.0.0/4
		240.0.0.0/4
		255.255.255.255
		$(get_wan_ip)
		$(cat ${IGNORE_LIST:=/dev/null} 2>/dev/null)
EOF
}

gen_spec_iplist() {
	cat <<-EOF
		0.0.0.0/8
		10.0.0.0/8
		100.64.0.0/10
		127.0.0.0/8
		169.254.0.0/16
		172.16.0.0/12
		192.0.0.0/24
		192.0.2.0/24
		192.88.99.0/24
		192.168.0.0/16
		198.18.0.0/15
		198.51.100.0/24
		203.0.113.0/24
		224.0.0.0/4
		240.0.0.0/4
		255.255.255.255
		$(get_wan_ip)
EOF
}

gen_include() {
	#[ -n "$FWI" ] || return 0
	# 恢复文件是 shell 脚本；原始规则只能放在 restore 的输入段内。
	printf '#!/bin/sh\nset -e\n' > "$FWI" || return 1
	extract_rules() {
		echo "*$1"
		iptables-save -t $1 | grep SS_SPEC_ |\
			sed -e "s/^-A \(OUTPUT\|PREROUTING\)/-I \1 1/"
		echo 'COMMIT'
	}
	cat <<-EOF >>$FWI
	iptables-save -c | grep -v "SS_SPEC" | iptables-restore -c
	iptables-restore -n <<-EOT
	$(extract_rules nat)
	$(extract_rules mangle)
	EOT
EOF
	return 0
}

while getopts ":s:l:S:L:i:e:a:b:w:p:G:D:k:oOuUfgrczh" arg; do
	case "$arg" in
		s)
			server=$OPTARG
			;;
		l)
			local_port=$OPTARG
			;;
		S)
			SERVER=$OPTARG
			;;
		L)
			LOCAL_PORT=$OPTARG
			;;
		i)
			IGNORE_LIST=$OPTARG
			;;
		e)
			EXT_ARGS=$OPTARG
			;;
		a)
			LAN_AC_IP=$OPTARG
			;;
		b)
			WAN_BP_IP=$(while read ip; do echo $ip; done < $OPTARG)
			;;
		w)
			WAN_FW_IP=$(while read ip; do echo $ip; done < $OPTARG)
			;;
		p)
			LAN_FP_IP=$(while read ip; do echo $ip; done < $OPTARG)
			;;
		G)
			LAN_GM_IP=$(while read ip; do echo $ip; done < $OPTARG)
			;;
		D)
		    PROXY_PORTS=$OPTARG
			;;
		o)
			OUTPUT=SS_SPEC_WAN_AC
			;;
		O)
			OUTPUT=SS_SPEC_WAN_FW
			;;
		u)
			TPROXY=1
			;;
		U)
			TPROXY=2
			;;
		g)
			RUNMODE=gfw
			;;
		r)
			RUNMODE=router
			;;
		c)
			RUNMODE=oversea
			;;
		z)
			RUNMODE=all
			;;
		k)
			LANCON=$OPTARG
			;;
		f)
			flush_r
			exit 0
			;;
		h)
			usage 0
			;;
	esac
done

if [ -z "$server" -o -z "$local_port" ]; then
	usage 2
fi

if [ "$TPROXY" = 1 ]; then
	SERVER=$server
	LOCAL_PORT=$local_port
elif [ "$TPROXY" = 2 ]; then
	: ${SERVER:?"You must assign an ip for the udp relay server."}
	: ${LOCAL_PORT:?"You must assign a port for the udp relay server."}
fi

# 策略表已被其他功能占用时明确拒绝，不先删除别人的路由。
if [ -n "$TPROXY" ] && ! owns_policy; then
	if ip rule show | grep -q 'lookup 100' || [ -n "$(ip route show table 100 2>/dev/null)" ]; then
		loger 3 "策略路由表 100 已占用，请先解决冲突。"
		exit 1
	fi
fi
flush_r && fw_rule && ipset_r && ac_rule && tp_rule && gen_include
result=$?
if [ "$result" != 0 ]; then
	# 失败时撤销本脚本创建的半套规则，并保留真实失败状态。
	flush_r
	loger 3 "Start failed!"
fi
exit "$result"
