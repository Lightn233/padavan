 void UnixServiceMain(int argc, char *argv[], char *name, SERVICE_FUNCTION *start, SERVICE_FUNCTION *stop)
 {
 	UINT mode = 0;
+#ifdef UNIX_LINUX
+	// 必须在 InitMayaqua 创建计时线程之前设置，不能只阻塞主线程。
+	// 服务进程返回后即退出，停止期间保持阻塞，避免重复信号触发监督进程重启。
+	if (argc >= 2 && StrCmpi(argv[1], UNIX_SVC_ARG_EXEC_SVC) == 0)
+	{
+		sigset_t stop_signals;
+		int error;
+		sigemptyset(&stop_signals);
+		sigaddset(&stop_signals, SIGTERM);
+		error = pthread_sigmask(SIG_BLOCK, &stop_signals, NULL);
+		if (error != 0)
+		{
+			fprintf(stderr, "Cannot block service stop signal: %d\n", error);
